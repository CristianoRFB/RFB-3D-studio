# Firebase Web App public identifiers (not secrets). Use an isolated Firebase Spark project.
# Leave empty to keep the entire application in local demonstration mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Only when running local Firebase emulators with Vite development.
VITE_USE_FIREBASE_EMULATORS=false
# Enable only for a verified, same-origin Worker preview
VITE_ENABLE_QUOTE_REQUESTS=false
