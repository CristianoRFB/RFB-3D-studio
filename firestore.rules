rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validConfig(c) {
      return c is map
        && c.keys().hasAll(['version', 'productId', 'colorId', 'finishId', 'sizeId', 'addonId', 'quantity'])
        && c.keys().hasOnly(['version', 'productId', 'colorId', 'finishId', 'sizeId', 'addonId', 'quantity'])
        && c.version == 2
        && c.productId in ['aura', 'orbita', 'nexo']
        && c.colorId in ['lilas', 'azul', 'coral', 'grafite']
        && c.finishId in ['fosco', 'metalico']
        && c.sizeId in ['p', 'm', 'g']
        && c.quantity is int && c.quantity >= 1 && c.quantity <= 10
        && (
          (c.productId == 'aura' && c.addonId in ['nenhum', 'alca', 'gravacao']) ||
          (c.productId == 'orbita' && c.addonId in ['nenhum', 'base', 'gravacao']) ||
          (c.productId == 'nexo' && c.finishId == 'fosco' && c.addonId in ['nenhum', 'suporte', 'gravacao'])
        );
    }

    function validDesign(uid) {
      return request.resource.data.keys().hasAll([
          'ownerUid', 'schemaVersion', 'title', 'config', 'revision', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'schemaVersion', 'title', 'config', 'revision', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerUid == uid
        && request.resource.data.schemaVersion == 2
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && validConfig(request.resource.data.config)
        && request.resource.data.revision is int
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{uid}/designs/{designId} {
      allow get: if isOwner(uid);
      allow list: if isOwner(uid) && request.query.limit <= 30;
      allow create: if isOwner(uid) && validDesign(uid)
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && resource.data.ownerUid == uid && validDesign(uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if isOwner(uid) && resource.data.ownerUid == uid;
    }
    match /users/{uid}/quotes/{quoteId} {
      allow get, list: if isOwner(uid) && (request.method == 'get' || request.query.limit <= 30);
      // Server owns quote totals and state; a browser cannot write them.
      allow create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
